NODE_ENV=production
PORT=4000
# postgresql://USER:PASSWORD@HOST:5432/hellodoc?schema=platform
# Use a runtime role that cannot create or drop schemas. Keep provisioning credentials separate.
# Never point staging/production at a dump of the local development database.
DATABASE_URL=
DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Public browser origin. Must be https in production.
CORS_ORIGIN=https://app.example.com
PUBLIC_WEB_ORIGIN=https://app.example.com

# Session/CSRF cookies. Use "none" when the SPA and API are on different hosts
# (e.g. Render static site + API). Use "lax" when they share a site.
COOKIE_SAMESITE=lax

# MFA is permanently disabled across HelloDoc
MFA_REQUIRED=false
# 64-char hex or a long passphrase. Do not reuse the development key.
SMS_PAYLOAD_ENCRYPTION_KEY=

# fake is refused in production unless dispatch is disabled.
SMS_PROVIDER=textlk
SMS_DISPATCH_ENABLED=false
SMS_DEFAULT_SENDER_ID=HelloDoc
# TEXTLK_API_TOKEN=
# TEXTLK_API_URL=https://app.text.lk/api/v3/sms/send

THROTTLE_LIMIT_PER_MINUTE=120
THROTTLE_REGISTRATION_LIMIT=5
THROTTLE_LOGIN_LIMIT=10
PG_POOL_MAX=10
