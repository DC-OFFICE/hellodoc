NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://hellodoc:hellodoc_dev_change_me@localhost:5432/hellodoc?schema=platform
CORS_ORIGIN=http://localhost:5173
PUBLIC_WEB_ORIGIN=http://localhost:5173
PG_POOL_MAX=10
# NEVER put a production database URL in local scripts.
# Bootstrap role/db/schema first using scripts/bootstrap-local-postgres.sql

# SMS
# fake keeps local sends off the network until the platform SMS gateway is enabled.
# textlk keeps the legacy Text.lk adapter. An enabled platform gateway uses SMSLenz.
SMS_PROVIDER=fake
SMS_DISPATCH_ENABLED=true
SMS_DEFAULT_SENDER_ID=HelloDoc
# 64-char hex OR any passphrase (hashed to AES-256 key). Required to enqueue SMS payloads.
SMS_PAYLOAD_ENCRYPTION_KEY=dev-only-change-me-hellodoc-sms-key
# Text.lk — https://text.lk/docs/send-sms/
# TEXTLK_API_TOKEN=
# TEXTLK_API_URL=https://app.text.lk/api/v3/sms/send
# SMS_HTTP_TIMEOUT_MS=12000
# Raise in local/integration testing only — keep tight in production.
# THROTTLE_LIMIT_PER_MINUTE=120
# THROTTLE_REGISTRATION_LIMIT=5
# THROTTLE_LOGIN_LIMIT=10

# MFA. Set MFA_REQUIRED=true in production so clinic manager, doctor, and cashier
# sessions cannot use clinical or billing routes until TOTP is confirmed.
# MFA_REQUIRED=false
# MFA_ENCRYPTION_KEY=
